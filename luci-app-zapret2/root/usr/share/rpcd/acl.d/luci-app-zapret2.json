{
	"luci-app-zapret2": {
		"description": "Grant access to zapret2 procedures",
		"read": {
			"cgi-io": [
				"exec"
			],
			"file": {
				"/opt/zapret2/config": [
					"read"
				],
				"/opt/zapret2/ipset/*": [
					"read"
				],
				"/opt/zapret2/init.d/openwrt/custom.d/*": [
					"read"
				],
				"/etc/crontabs/root": [
					"read"
				],
				"/tmp/zapret*": [
					"read"
				],
				"/bin/ps*": [
					"exec"
				],
				"/bin/cat*": [
					"exec"
				],
				"/bin/busybox*": [
					"exec"
				],
				"/bin/opkg*": [
					"exec"
				],
				"/usr/bin/apk*": [
					"exec"
				],
				"/usr/bin/find*": [
					"exec"
				],
				"/opt/zapret2/restore-def-cfg.sh*": [
					"exec"
				],
				"/opt/zapret2/script-exec.sh*": [
					"exec"
				]
			},
			"uci": [
				"zapret2",
				"network"
			],
			"ubus": {
				"luci": [
					"getInitList"
				],
				"openwrtzapret": [
					"status",
					"profile_active",
					"lists_status",
					"list_profiles",
					"get_profile",
					"get_profile_result",
					"current_job",
					"job_status",
					"job_result",
					"flowseal_status",
					"flowseal_check"
				],
				"service": [
					"list"
				]
			}
		},
		"write": {
			"ubus": {
				"openwrtzapret": [
					"start",
					"stop",
					"restart",
					"apply_profile",
					"set_manual",
					"start_test",
					"start_test_all",
					"cancel_job",
					"start_flowseal_update",
					"set_profile_lock",
					"delete_profile",
					"import_user_strategy",
					"put_list",
					"remove_list",
					"reset_lists"
				]
			},
			"file": {
				"/opt/zapret2/config": [
					"write"
				],
				"/opt/zapret2/ipset/*": [
					"write"
				],
				"/opt/zapret2/init.d/openwrt/custom.d/*": [
					"write"
				],
				"/etc/crontabs/root": [
					"write"
				]
			},
			"uci": [
				"zapret2"
			]
		}
	}
}
