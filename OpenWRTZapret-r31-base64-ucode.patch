+# LuCI already uses ucode; unlike BusyBox base64, b64dec() is always available here.
+# Invalid Base64 must fail, so callers keep their existing invalid_data handling.
+owz_base64_decode() {
+	ucode -e 'import { stdin } from "fs"; let value = b64dec(stdin.read("all")); if (value == null) exit(1); print(value);'
+}
+
 owz_list_put() {
 	local name="$1" data="$2" target tmp source
 	target=$(owz_list_target "$name") || { printf '%s\n' '{"ok":false,"error":"invalid_list"}'; return 0; }
@@ -430,7 +436,7 @@
 	if ! owz_lock list_put; then printf '%s\n' '{"ok":false,"error":"busy"}'; return 0; fi
 	owz_list_paths_ready "$target" || { printf '%s\n' '{"ok":false,"error":"list_unavailable"}'; return 0; }
 	tmp=$(mktemp /tmp/openwrtzapret-list.XXXXXX) || { printf '%s\n' '{"ok":false,"error":"temporary_file_failed"}'; return 0; }
-	if [ "$data" = - ]; then : > "$tmp"; else printf '%s' "$data" | /bin/busybox base64 -d > "$tmp" 2>/dev/null; fi
+	if [ "$data" = - ]; then : > "$tmp"; else printf '%s' "$data" | owz_base64_decode > "$tmp" 2>/dev/null; fi
 	if [ "$?" -ne 0 ] || [ "$(wc -c < "$tmp")" -gt 49152 ] ||
 		! LC_ALL=C tr -d '\000' < "$tmp" | cmp -s - "$tmp"; then
 		rm -f "$tmp"
@@ -784,7 +790,7 @@
 	if ! owz_lock profile_import_user; then printf '%s\n' '{"ok":false,"error":"busy"}'; return 0; fi
